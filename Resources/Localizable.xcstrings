          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出全部模板？"
          }
        }
      }
    },
    "导出包含全部启用和停用模板、当前顺序与原始正文。正文可能含有个人信息或密钥，请谨慎选择本地保存位置。变量不会展开，也不会读取剪贴板；不包含目录授权或历史记录。": {
      "comment": "Templates screen: library list, template actions and recovery dialogs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export includes enabled and disabled templates, their order, and original contents. Contents may include personal information or keys, so choose a local destination carefully. Variables are not expanded and the clipboard is not read. Folder access and history are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出包含全部启用和停用模板、当前顺序与原始正文。正文可能含有个人信息或密钥，请谨慎选择本地保存位置。变量不会展开，也不会读取剪贴板；不包含目录授权或历史记录。"
          }
        }
      }
    },
    "导出文件夹在操作期间发生变化，未发布模板文件。请重新选择位置。": {
      "comment": "Template import/export file validation error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export folder changed during the operation. No template file was published. Choose a location again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出文件夹在操作期间发生变化，未发布模板文件。请重新选择位置。"
          }
        }
      }
    },
    "导出模板配置，不会读取剪贴板，也不包含 Finder 文件夹授权。模板正文可能包含你自行写入的私人信息。": {
      "comment": "Native file/folder selection or confirmation panel in the main app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export template settings without reading the clipboard or including Finder folder access. Template contents may include private information you have entered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出模板配置，不会读取剪贴板，也不包含 Finder 文件夹授权。模板正文可能包含你自行写入的私人信息。"
          }
        }
      }
    },
    "将 QuickFile 存储文件夹及模板、标记和锁文件恢复为仅当前用户可读写，不替换文件内容。链接、所有者异常或目录身份变化时停止。修复失败也可能已调整部分权限。": {
      "comment": "Permission repair confirmation: fixed scope, refusal conditions, and partial-change disclosure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore owner-only access to the QuickFile storage folder and its template, marker, and lock files without replacing contents. Stop on links, unexpected ownership, or changed directory identity. A failed repair may still change some permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 QuickFile 存储文件夹及模板、标记和锁文件恢复为仅当前用户可读写，不替换文件内容。链接、所有者异常或目录身份变化时停止。修复失败也可能已调整部分权限。"
          }
        }
      }
    },
    "将本地共享目录、请求队列及其归档目录、队列锁和最多 256 条请求记录恢复为仅当前用户可读写。不改变原始内容、不修改归档文件、不移出待办，也不恢复自动处理。链接、所有者异常或目录身份变化时停止，失败时可能已调整部分权限。": {
      "comment": "Storage recovery or optional file opening: user-facing status, action, or explicit confirmation; do not imply that file creation failed or that requests resume automatically.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore owner-only access for local shared storage, the request queue and its archive directory, the queue lock, and up to 256 requests. Original contents and archived files remain unchanged. Requests stay pending and automatic processing stays paused. Stop on links, unexpected ownership, or changed directory identity; some permissions may already have changed if repair fails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将本地共享目录、请求队列及其归档目录、队列锁和最多 256 条请求记录恢复为仅当前用户可读写。不改变原始内容、不修改归档文件、不移出待办，也不恢复自动处理。链接、所有者异常或目录身份变化时停止，失败时可能已调整部分权限。"
          }
        }
      }
    },
    "将本地共享目录及授权记录、迁移标记和锁文件恢复为仅当前用户可读写。不会删除、替换或解析书签。链接、所有者异常或目录身份变化时停止，失败时可能已调整部分权限。": {
      "comment": "Storage recovery or optional file opening: user-facing status, action, or explicit confirmation; do not imply that file creation failed or that requests resume automatically.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore owner-only access to the local shared folder, authorization records, migration marker, and lock file. No bookmarks are deleted, replaced, or resolved. Stop on links, unexpected ownership, or changed directory identity. Some permissions may already have changed if repair fails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将本地共享目录及授权记录、迁移标记和锁文件恢复为仅当前用户可读写。不会删除、替换或解析书签。链接、所有者异常或目录身份变化时停止，失败时可能已调整部分权限。"
          }
        }
      }
    },
    "将用“%@”替换当前配置。先在本地保留原始配置备份，备份失败则停止恢复。这不是追加导入。": {
      "comment": "Main app: file creation or template-library operation feedback and recovery guidance. Arguments (source order): 1 = display name of the selected recovery source.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the current settings with “%@”. QuickFile first keeps a local backup of the original and stops if backup fails. This replaces the configuration rather than appending templates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将用“%@”替换当前配置。先在本地保留原始配置备份，备份失败则停止恢复。这不是追加导入。"
          }
        }
      }
    },
