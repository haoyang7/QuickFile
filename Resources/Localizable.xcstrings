    "template.import.appended": {
      "comment": "Completion message after appending imported templates. The integer is the number added, not the total library size. Main app: file creation or template-library operation feedback and recovery guidance. Arguments (source order): 1 = number of newly imported templates, not total library size.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Appended %lld template."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Appended %lld templates."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已追加导入 %lld 个模板。"
          }
        }
      }
    },
