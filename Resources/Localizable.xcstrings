      "comment": "Template editor: fields, validation, content limits and unsaved drafts. Arguments (source order): 1 = maximum template count; 2 = formatted maximum serialized template-file size.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
