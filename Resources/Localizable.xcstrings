{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "": {
      "comment": "Intentional empty UI label; accessibility text is supplied separately. Do not translate.",
      "shouldTranslate": false
    },
    "\n文档类型：%@": {
      "comment": "Template editor: copied draft summary; values are literal user data. Arguments (source order): 1 = localized description of the Office document type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nDocument type: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n文档类型：%@"
          }
        }
      }
    },
    "%@ %lld 个 · 改名 %lld 个 · 跳过重复 %lld 个": {
      "comment": "Template import/recovery preview before changes are applied. Arguments (source order): 1 = localized operation label (Recover or Add); 2 = number of templates in the preview; 3 = number of imported templates renamed to avoid a name conflict; 4 = number of duplicate templates skipped during import.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld · Renamed: %lld · Duplicates skipped: %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld 个 · 改名 %lld 个 · 跳过重复 %lld 个"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "Template import/recovery preview before changes are applied. Diagnostics screen, including folder access management and extension health. Arguments (source order): 1 = filename extension or localized No extension label; 2 = localized Enabled/Disabled state / Alternative use: 1 = localized Finder activity label; 2 = formatted event timestamp.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@，无法确定路径是否存在：%@": {
      "comment": "Folder diagnostics: identity, access and temporary write-test results. Arguments (source order): 1 = localized reason for the failure; 2 = underlying error detail; it may follow the operating-system language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Could not determine whether the path exists: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，无法确定路径是否存在：%@"
          }
        }
      }
    },
    "%lld / %lld 个目录": {
      "comment": "Diagnostics screen, including folder access management and extension health. Arguments (source order): 1 = number of folder-access records matching the filter; 2 = total number of saved folder-access records.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders: %lld / %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld 个目录"
          }
        }
      }
    },
    "%lld 个模板包含 {{clipboard}}。导入不会读取剪贴板；日后创建文件时可能使用剪贴板内容。": {
      "comment": "Template import/recovery preview before changes are applied. Arguments (source order): 1 = number of templates containing the literal {{clipboard}} variable. Keep template variable tokens in double braces unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates containing {{clipboard}}: %lld. Import does not read the clipboard, but later file creation may use clipboard contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个模板包含 {{clipboard}}。导入不会读取剪贴板；日后创建文件时可能使用剪贴板内容。"
          }
        }
      }
    },
    "%lld 个需处理": {
      "comment": "Diagnostics screen, including folder access management and extension health. Arguments (source order): 1 = number of folder-access records needing attention.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need attention: %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个需处理"
          }
        }
      }
    },
    "%lld 字节": {
      "comment": "Template editor: fields, validation, content limits and unsaved drafts. Arguments (source order): 1 = UTF-8 byte count, not character count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bytes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 字节"
          }
        }
      }
    },
    "1. 启用 Finder 右键菜单": {
      "comment": "Finder setup: extension activation, permissions and first-creation verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Enable the Finder menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 启用 Finder 右键菜单"
          }
        }
      }
    },
    "2. 确认 Finder 的文件夹授权": {
      "comment": "Finder setup: extension activation, permissions and first-creation verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Confirm Finder folder access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 确认 Finder 的文件夹授权"
          }
        }
      }
    },
    "2. 选择 Finder 将要使用的文件夹": {
      "comment": "Finder setup: extension activation, permissions and first-creation verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Choose the folder to use in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 选择 Finder 将要使用的文件夹"
          }
        }
      }
    },
    "3. 在 Finder 创建第一个文件": {
      "comment": "Finder setup: extension activation, permissions and first-creation verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Create your first file in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 在 Finder 创建第一个文件"
          }
        }
      }
    },
    "App 内注册查询未完成（退出码 %d）。%@可打开扩展管理，或在终端核对注册记录。": {
      "comment": "Finder extension installation/registration diagnostics; evidence is not proof of successful creation. Arguments (source order): 1 = process exit status; 2 = diagnostic detail.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The in-app registration query did not complete (exit code %d). %@ Open extension management or check registration in Terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 内注册查询未完成（退出码 %d）。%@可打开扩展管理，或在终端核对注册记录。"
          }
        }
      }
    },
    "Console 已打开，请筛选子系统 com.haoyoung.QuickFile。": {
      "comment": "Diagnostics operation result, including access refresh/removal and local evidence export.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Console is open. Filter by subsystem com.haoyoung.QuickFile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Console 已打开，请筛选子系统 com.haoyoung.QuickFile。"
          }
        }
      }
    },
    "Excel 工作簿": {
      "comment": "Built-in template display name. Preserve historical names when revising a translation; see LOCALIZATION.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel Workbook"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel 工作簿"
          }
        }
      }
    },
    "FileManager 可写": {
      "comment": "Diagnostics screen, including folder access management and extension health.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FileManager Reports Writable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FileManager 可写"
          }
        }
      }
    },
    "FileManager 报告该目录不可写。": {
      "comment": "Folder diagnostics: identity, access and temporary write-test results.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FileManager reports that the folder is not writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FileManager 报告该目录不可写。"
          }
        }
      }
    },
    "Finder 交接队列中有超过大小上限的记录，原始记录仍保留，自动处理已暂停。可重试读取其他可用请求；重试不会移除超限记录。": {
      "comment": "Main app: file creation or template-library operation feedback and recovery guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder handoff queue contains oversized records. Originals are kept and automatic processing is paused. Retry reading other available requests; retrying does not remove oversized records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 交接队列中有超过大小上限的记录，原始记录仍保留，自动处理已暂停。可重试读取其他可用请求；重试不会移除超限记录。"
          }
        }
      }
    },
    "Finder 写入授权": {
      "comment": "Diagnostics screen, including folder access management and extension health.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder Write Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 写入授权"
          }
        }
      }
    },
    "Finder 只在明确授权的目录及其子目录中写入；创建时也可按提示授权。授权仅保存在本机，不会上传。": {
      "comment": "Diagnostics screen, including folder access management and extension health.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder writes only to explicitly authorized folders and their subfolders. You can grant access when prompted during creation. Access records stay on this Mac and are never uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 只在明确授权的目录及其子目录中写入；创建时也可按提示授权。授权仅保存在本机，不会上传。"
          }
        }
      }
    },
    "Finder 右键菜单设置（可选）": {
      "comment": "New File screen: destination selection, template choice and Finder setup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder Menu Setup (Optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 右键菜单设置（可选）"
          }
        }
      }
    },
    "Finder 文件夹授权未保存": {
      "comment": "Finder setup: extension activation, permissions and first-creation verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder folder access was not saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 文件夹授权未保存"
          }
        }
      }
    },
    "Finder 的快捷授权请求已达上限（64 个），请先处理待办请求后重试。": {
      "comment": "Persistent Finder request queue: validation or recovery error. Preserve the stated action boundaries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder authorization queue has reached its limit of 64 requests. Handle pending requests before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 的快捷授权请求已达上限（64 个），请先处理待办请求后重试。"
          }
        }
      }
    },
    "Finder 的快捷授权请求超过大小上限，请从 Finder 重新发起。": {
      "comment": "Persistent Finder request queue: validation or recovery error. Preserve the stated action boundaries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder authorization request exceeds the size limit. Start it again from Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 的快捷授权请求超过大小上限，请从 Finder 重新发起。"
          }
        }
      }
    },
    "Finder 菜单上下文不可用": {
      "comment": "Finder activity/failure classification shown in Diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menu context unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单上下文不可用"
          }
        }
      }
    },
    "Finder 菜单已生成": {
      "comment": "Finder activity/failure classification shown in Diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menu prepared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单已生成"
          }
        }
      }
    },
    "Finder 菜单显示": {
      "comment": "Templates screen: optional Finder menu display settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder Menu Display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单显示"
          }
        }
      }
    },
    "Finder 菜单最多显示的模板数": {
      "comment": "Templates screen: optional Finder menu display settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum number of templates in the Finder menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单最多显示的模板数"
          }
        }
      }
    },
    "Finder 菜单状态已失效，请重新打开 Finder 菜单后再试。": {
      "comment": "Finder file-creation failure; no destination access should be implied unless explicitly stated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder menu context is no longer valid. Reopen the menu and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单状态已失效，请重新打开 Finder 菜单后再试。"
          }
        }
      }
    },
    "Finder 菜单设置已保存。": {
      "comment": "Finder menu settings: saved summary, save confirmation or validation feedback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menu settings saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单设置已保存。"
          }
        }
      }
    },
    "Finder 菜单设置已更新，但无法确认完整写入。请重新加载并检查当前设置。": {
      "comment": "Shown after Finder menu settings were published but the write could not be fully confirmed. Reload before saving again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menu settings were updated, but the write could not be fully confirmed. Reload and check the current settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单设置已更新，但无法确认完整写入。请重新加载并检查当前设置。"
          }
        }
      }
    },
    "Finder 菜单设置无效，已保留上次有效设置。请重新保存。": {
      "comment": "Finder menu preferences: read/write error and repair guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menu settings are invalid. The last valid settings have been kept. Save them again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单设置无效，已保留上次有效设置。请重新保存。"
          }
        }
      }
    },
    "Finder 请求使用的模板已不可用，请重新打开 Finder 菜单。": {
      "comment": "Finder authorization and resumed creation result.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The template for this Finder request is no longer available. Reopen the Finder menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 请求使用的模板已不可用，请重新打开 Finder 菜单。"
          }
        }
      }
    },
    "GitHub 当前没有符合所选渠道的已发布版本。": {
      "comment": "No published release matches the user's stable or beta choice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub has no published releases for the selected channel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 当前没有符合所选渠道的已发布版本。"
          }
        }
      }
    },
    "GitHub 暂时限制了检查请求，请稍后重试。": {
      "comment": "GitHub rejected a manual update check due to rate limiting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub has temporarily limited update requests. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 暂时限制了检查请求，请稍后重试。"
          }
        }
      }
    },
    "GitHub 版本信息超过检查上限，无法确认最新版本。": {
      "comment": "Community update check exceeded its response or pagination budget.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub version information exceeds the check limit. The latest version could not be confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 版本信息超过检查上限，无法确认最新版本。"
          }
        }
      }
    },
    "GitHub 返回的版本信息无效，请稍后重试。": {
      "comment": "Community update check received an invalid release response.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returned invalid version information. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 返回的版本信息无效，请稍后重试。"
          }
        }
      }
    },
    "Office 模板只能创建对应格式的空白文档，不能修改扩展名或预填文本。": {
      "comment": "Template editor: draft validation error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Office templates create only blank documents in the corresponding format. Their extension and initial text cannot be changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 模板只能创建对应格式的空白文档，不能修改扩展名或预填文本。"
          }
        }
      }
    },
    "Office 模板需要模板文件版本 3。": {
      "comment": "Template import/export: format validation, limits and duplicate-name handling.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Office templates require template file version 3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 模板需要模板文件版本 3。"
          }
        }
      }
    },
    "PowerPoint 演示文稿": {
      "comment": "Built-in template display name. Preserve historical names when revising a translation; see LOCALIZATION.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPoint Presentation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPoint 演示文稿"
          }
        }
      }
    },
    "QuickFile Finder Extension 将能够在所选目录及其子目录中创建文件。": {
      "comment": "Diagnostics screen, including folder access management and extension health.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickFile Finder Extension will be able to create files in the selected folder and its subfolders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickFile Finder Extension 将能够在所选目录及其子目录中创建文件。"
          }
        }
      }
    },
    "QuickFile 中已有文件夹请求。请先处理或取消该请求。": {
      "comment": "System folder service: a second request is rejected while the first is pending or being confirmed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickFile already has a folder request. Complete or cancel it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickFile 中已有文件夹请求。请先处理或取消该请求。"
          }
        }
      }
    },
    "QuickFile 无法创建文件": {
      "comment": "Finder extension: alert or creation/setup feedback.",
      "extractionState": "manual",
      "localizations": {
