    },
    "Word 文档": {
      "comment": "Built-in template display name. Keep historical translations compatible with already-saved names; see LOCALIZATION.md. Built-in template display name. Preserve historical names when revising a translation; see LOCALIZATION.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word Document"
